FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpango-1.0-0 libpangoft2-1.0-0 libharfbuzz0b fonts-noto-core fonts-dejavu-core libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY . .
# Railway: volume mounted at /data (root-owned) -> run as root, no VOLUME/HEALTHCHECK instructions
ENV MPLBACKEND=Agg CIVILBOT_DB=/data/civilbot.sqlite3 BACKUP_DIR=/data/backups \
    WORKERS=2 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 PYTHONUNBUFFERED=1
RUN mkdir -p /data/backups
CMD ["sh", "start.sh"]
